DATABASE_URL=postgresql://talavera:talavera@localhost:5432/talavera
DATABASE_DRIVER=node-postgres
TEST_DATABASE_URL=postgresql://talavera:talavera@localhost:5432/talavera_invoice_test
# Optional source used only by an explicit, human-controlled refresh procedure.
# REMOTE_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-value
PORT=5001
LOCAL_ADMIN_EMAIL=admin@talavera.local
LOCAL_ADMIN_PASSWORD=choose-a-local-password

# Production defaults to the existing Neon driver when DATABASE_DRIVER is absent.
# REPLIT_DOMAINS=
# REPL_ID=
# ISSUER_URL=https://replit.com/oidc

# Invoice private source storage. Production must use replit with a bucket.
INVOICE_STORAGE_BACKEND=filesystem
INVOICE_STORAGE_ROOT=.private/invoice-sources
# INVOICE_ALLOWED_ORIGIN=https://your-app.example
# REPLIT_OBJECT_STORAGE_BUCKET=
# Required only when an authorized operator deliberately runs `npm run db:migrate`.
INVOICE_MIGRATION_APPROVED=false
INVOICE_MAX_FILE_BYTES=10485760
INVOICE_MAX_SOURCE_PAGES=10
INVOICE_CONFIRMED_RETENTION_DAYS=365
INVOICE_FEEDBACK_RETENTION_DAYS=365
INVOICE_ABANDONED_RETENTION_DAYS=30
INVOICE_PILOT_LANGUAGE=en
INVOICE_PILOT_CURRENCY=USD
INVOICE_WORKER_MAX_ATTEMPTS=3
INVOICE_WORKER_LEASE_SECONDS=120
INVOICE_WORKER_POLL_SECONDS=15
INVOICE_EXTRACTION_PROVIDER=openai
INVOICE_OPENAI_MODEL=gpt-5.6-terra
INVOICE_ENGINE_VERSION=invoice-v1
INVOICE_PROPOSAL_SCHEMA_VERSION=invoice-proposal-v1
INVOICE_OPENAI_EXECUTION_MODE=background
INVOICE_OPENAI_STORE_RESPONSE=true
INVOICE_OPENAI_PRIVACY_PROFILE=standard
# OPENAI_API_KEY=
# OPENAI_WEBHOOK_SECRET=
INVOICE_MAX_IMAGE_PIXELS=40000000
INVOICE_VALIDATION_TIMEOUT_MS=15000
INVOICE_VALIDATION_CONCURRENCY=2
# OPENAI_API_KEY=
# OPENAI_INVOICE_MODEL=
